@model List<FruitShop.Shared.Contracts.OrderDto>
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi";
}

<div class="container py-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-5 font-serif text-uppercase mb-2" style="color: #275D38; letter-spacing: 0.1em;">Đơn Hàng Của Tôi</h1>
        <p class="text-muted" style="letter-spacing: 0.05em;">Theo dõi tiến độ xử lý và lịch sử đặt hàng theo thời gian thực</p>
        <div class="mx-auto" style="width: 60px; height: 2px; background-color: #C5A880;"></div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["OrderSuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-radius: 8px;">
            <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["OrderSuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["OrderErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-radius: 8px;">
            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["OrderErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="card shadow-sm border-0 py-5 text-center" style="background: #FFFFFF; border-radius: 12px;">
            <div class="card-body">
                <i class="bi bi-receipt text-muted" style="font-size: 4rem; opacity: 0.4;"></i>
                <h4 class="mt-3 font-serif">Quý khách chưa có đơn hàng nào</h4>
                <p class="text-muted mb-4">Hãy khám phá bộ sưu tập trái cây nhập khẩu tươi ngon của chúng tôi ngay hôm nay.</p>
                <a asp-controller="Products" asp-action="ListProduct" class="btn btn-luxury px-4 py-2 text-uppercase" style="letter-spacing: 0.1em; border-radius: 8px;">
                    <i class="bi bi-bag-plus me-2"></i> Khám Phá Bộ Sưu Tập
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Orders List -->
        <div class="row g-4">
            @foreach (var order in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0" style="background: #FFFFFF; border-radius: 12px; overflow: hidden; border: 1px solid #EBE4DA !important;">
                        <!-- Order Header -->
                        <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2" style="background-color: #FBF9F5 !important;">
                            <div>
                                <span class="text-uppercase fw-bold font-serif" style="color: #275D38; font-size: 1.1rem; letter-spacing: 0.05em;">
                                    Đơn Hàng #@order.OrderCode
                                </span>
                                <span class="text-muted small ms-2 d-block d-sm-inline">
                                    <i class="bi bi-calendar3 me-1"></i> @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </span>
                                @if (!string.IsNullOrEmpty(order.BranchName))
                                {
                                    <span class="badge bg-light text-dark border ms-sm-2 mt-1 mt-sm-0" style="font-size: 0.75rem;">
                                        <i class="bi bi-shop text-success me-1"></i> @order.BranchName
                                    </span>
                                }
                            </div>

                            <!-- Live Status Badge -->
                            <div>
                                @switch (order.OrderStatus)
                                {
                                    case "Pending":
                                        <span class="badge px-3 py-2 rounded-pill font-monospace" style="background-color: #FEF3C7; color: #92400E; font-size: 0.85rem; font-weight: 600;">
                                            <i class="bi bi-clock-history me-1"></i> Chờ Xác Nhận
                                        </span>
                                        break;
                                    case "Confirmed":
                                    case "Confirm":
                                        <span class="badge px-3 py-2 rounded-pill font-monospace" style="background-color: #E0F2FE; color: #0369A1; font-size: 0.85rem; font-weight: 600;">
                                            <i class="bi bi-box-seam me-1"></i> Đã Xác Nhận &amp; Đóng Gói
                                        </span>
                                        break;
                                    case "Shipping":
                                        <span class="badge px-3 py-2 rounded-pill font-monospace" style="background-color: #DBEAFE; color: #1D4ED8; font-size: 0.85rem; font-weight: 600;">
                                            <i class="bi bi-truck me-1"></i> Đang Giao Hàng
                                        </span>
                                        break;
                                    case "Completed":
                                        <span class="badge px-3 py-2 rounded-pill font-monospace" style="background-color: #DCFCE7; color: #15803D; font-size: 0.85rem; font-weight: 600;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Giao Hàng Thành Công
                                        </span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge px-3 py-2 rounded-pill font-monospace" style="background-color: #FEE2E2; color: #B91C1C; font-size: 0.85rem; font-weight: 600;">
                                            <i class="bi bi-x-circle-fill me-1"></i> Đã Hủy
                                        </span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">@order.OrderStatus</span>
                                        break;
                                }
                            </div>
                        </div>

                        <!-- Order Details List -->
                        <div class="card-body p-4">
                            <div class="table-responsive mb-3">
                                <table class="table table-borderless align-middle mb-0">
                                    <thead class="text-muted small border-bottom" style="letter-spacing: 0.05em;">
                                        <tr>
                                            <th style="width: 50%;">SẢN PHẨM</th>
                                            <th class="text-center" style="width: 15%;">ĐƠN GIÁ</th>
                                            <th class="text-center" style="width: 15%;">SỐ LƯỢNG</th>
                                            <th class="text-end" style="width: 20%;">THÀNH TIỀN</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in order.Details)
                                        {
                                            <tr class="border-bottom">
                                                <td class="py-3">
                                                    <span class="fw-semibold text-dark">@item.ProductName</span>
                                                    @if (item.DiscountPercent > 0)
                                                    {
                                                        <span class="badge bg-danger ms-2">-@item.DiscountPercent%</span>
                                                    }
                                                </td>
                                                <td class="text-center py-3 text-muted">@item.UnitPrice.ToString("N0") đ</td>
                                                <td class="text-center py-3">
                                                    <span class="badge bg-light text-dark border px-2 py-1">@item.Quantity</span>
                                                </td>
                                                <td class="text-end py-3 fw-bold text-dark">@item.SubTotal.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Delivery & Payment Info -->
                            <div class="row g-3 pt-2 text-muted small">
                                <div class="col-md-7">
                                    <p class="mb-1">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> <strong>Địa chỉ nhận hàng:</strong> @order.ShippingAddress
                                    </p>
                                    <p class="mb-1">
                                        <i class="bi bi-telephone-fill text-success me-1"></i> <strong>Người nhận:</strong> @order.CustomerName (@order.CustomerPhone)
                                    </p>
                                    @if (!string.IsNullOrEmpty(order.Note))
                                    {
                                        <p class="mb-0 text-muted fst-italic">
                                            <i class="bi bi-chat-left-text me-1"></i> <strong>Ghi chú:</strong> @order.Note
                                        </p>
                                    }
                                </div>
                                <div class="col-md-5 text-md-end">
                                    <p class="mb-1">
                                        <strong>Hình thức thanh toán:</strong> @(order.PaymentMethod == "COD" ? "Tiền mặt khi nhận hàng (COD)" : order.PaymentMethod)
                                    </p>
                                    <p class="mb-0">
                                        <strong>Trạng thái thanh toán:</strong> 
                                        @if (order.PaymentStatus == "Paid")
                                        {
                                            <span class="text-success fw-bold"><i class="bi bi-check-all me-1"></i> Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning fw-bold"><i class="bi bi-hourglass-split me-1"></i> Chưa thanh toán</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Order Footer & Action Bar -->
                        <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div class="d-flex align-items-baseline gap-2">
                                <span class="text-muted small text-uppercase" style="letter-spacing: 0.05em;">Tổng thanh toán:</span>
                                <span class="fs-4 fw-bold font-serif" style="color: #275D38;">@order.FinalAmount.ToString("N0") đ</span>
                            </div>

                            <div>
                                <!-- Khách hàng chỉ được hủy khi đơn ở trạng thái Pending hoặc Confirmed (chưa Shipping) -->
                                @if (order.OrderStatus == "Pending" || order.OrderStatus == "Confirmed" || order.OrderStatus == "Confirm")
                                {
                                    <form asp-controller="Order" asp-action="CancelOrder" method="post" class="d-inline" onsubmit="return confirm('Quý khách có chắc chắn muốn HỦY đơn hàng #@order.OrderCode không? Số lượng sản phẩm sẽ được tự động hoàn lại vào kho.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm px-3 py-2 rounded-pill font-weight-bold shadow-sm" style="font-size: 0.85rem;">
                                            <i class="bi bi-x-circle me-1"></i> Hủy Đơn Hàng
                                        </button>
                                    </form>
                                }
                                else if (order.OrderStatus == "Shipping")
                                {
                                    <span class="text-muted small d-inline-flex align-items-center">
                                        <i class="bi bi-info-circle-fill text-primary me-1"></i> Đơn hàng đang được vận chuyển.
                                    </span>
                                }
                                else if (order.OrderStatus == "Completed")
                                {
                                    <span class="text-success small fw-semibold d-inline-flex align-items-center">
                                        <i class="bi bi-check2-circle me-1"></i> Đơn hàng đã hoàn tất. Cảm ơn quý khách!
                                    </span>
                                }
                                else if (order.OrderStatus == "Cancelled")
                                {
                                    <span class="text-danger small fw-semibold d-inline-flex align-items-center">
                                        <i class="bi bi-dash-circle me-1"></i> Đơn hàng này đã bị hủy.
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
