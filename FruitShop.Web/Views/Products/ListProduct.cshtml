@model FruitShop.Web.ViewModels.ProductListViewModel

@{
    ViewData["Title"] = "Bộ Sưu Tập Trái Cây Thượng Hạng";
}

<style>
    /* Banner đầu trang danh mục */
    .catalog-header {
        background: linear-gradient(180deg, rgba(250,248,245,0.6) 0%, rgba(243,239,234,0.9) 100%), url('https://images.unsplash.com/photo-1610832958506-aa56368176cf?q=80&w=1600') center/cover;
        padding: 70px 0 50px 0;
        border-bottom: 1px solid rgba(197, 168, 128, 0.25)
    }

    /* Sidebar Filter Style */
    .filter-card {
        background-color: #FFFFFF;
        border: 1px solid rgba(197, 168, 128, 0.25);
        padding: 1.8rem;
    }

    .filter-title {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        letter-spacing: 0.05em;
        color: var(--text-main);
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(197, 168, 128, 0.3);
        margin-bottom: 1.2rem;
    }

    /* Form controls custom */
    .form-check-input:checked {
        background-color: var(--accent-green);
        border-color: var(--accent-green);
    }

    .form-check-label {
        font-size: 0.88rem;
        color: var(--text-main);
        cursor: pointer;
    }

    .category-count {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    /* Top Sort & Bar */
    .catalog-toolbar {
        background-color: #FFFFFF;
        border: 1px solid rgba(197, 168, 128, 0.25);
        padding: 0.8rem 1.2rem;
        margin-bottom: 2rem;
    }

    .form-select-luxury {
        border: 1px solid rgba(197, 168, 128, 0.4);
        border-radius: 0;
        font-size: 0.85rem;
        color: var(--text-main);
        background-color: #FAF8F5;
        padding: 0.4rem 1rem;
    }

        .form-select-luxury:focus {
            border-color: var(--accent-gold);
            box-shadow: none;
        }

    /* Product Card Enhancement */
    .product-card {
        background: #FFFFFF;
        border: 1px solid rgba(197, 168, 128, 0.2);
        transition: all 0.35 ease;
        position: relative;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.06);
            border-color: var(--accent-gold);
        }

    .product-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background-color: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        color: var(--accent-green);
        border: 1px solid var(--accent-gold);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        padding: 0.35rem 0.75rem;
        text-transform: uppercase;
        z-index: 2;
    }

    .product-img-wrapper {
        position: relative;
        overflow: hidden;
        height: 260px;
    }

        .product-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

    .product-card:hover .product-img-wrapper img {
        transform: scale(1.05);
    }

    /* Custom Pagination */
    .pagination-luxury .page-link {
        color: var(--text-main);
        background-color: transparent;
        border: 1px solid rgba(197, 168, 128, 0.3);
        margin: 0 3px;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    .pagination-luxury .page-item.active .page-link {
        background-color: var(--accent-green);
        border-color: var(--accent-green);
        color: #FFFFFF;
    }

    .pagination-luxury .page-link:hover {
        background-color: var(--accent-gold);
        border-color: var(--accent-gold);
        color: #FFFFFF;
    }
</style>

<!-- Catalog Header Banner -->
<section class="catalog-header text-center">
    <div class="container">
        <span class="fruit-tag mb-2 d-block">LA COLLECTION EXCLUSIVE</span>
        <h1 class="display-5 font-serif mb-3">Danh Sách Trái Cây Thượng Hạng</h1>
        <p class="text-muted mx-auto" style="max-width: 600px; font-size: 0.95rem;">
            Những lô trái cây chất lượng cao nhất được thu hoạch thủ công và chuyển trực tiếp bằng đường hàng không mỗi ngày.
        </p>
    </div>
</section>

<!-- Main Catalog Content -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">

            <!-- SIDEBAR FILTER -->
            <div class="col-lg-3">
                <form asp-action="ListProduct" method="get" class="filter-card shadow-sm sticky-lg-top" style="top: 100px; z-index: 10;">
                    <input type="hidden" name="sort" value="@Model.Sort" />
                    <div class="filter-group mb-4">
                        <h3 class="filter-title">Danh Mục Sản Phẩm</h3>
                        <div class="form-check mb-2"><input class="form-check-input" type="radio" name="categoryId" id="category-all" value="" checked="@(Model.CategoryId is null)"><label class="form-check-label" for="category-all">Tất cả danh mục</label></div>
                        @foreach (var category in Model.Categories)
                        {
                            <div class="form-check mb-2"><input class="form-check-input" type="radio" name="categoryId" id="category-@category.Id" value="@category.Id" checked="@(Model.CategoryId == category.Id)"><label class="form-check-label" for="category-@category.Id">@category.Name</label></div>
                        }
                    </div>
                    <div class="filter-group mb-4">
                        <h3 class="filter-title">Mức Giá</h3>
                        <div class="form-check mb-2"><input class="form-check-input" type="radio" name="priceRange" id="price-all" value="" checked="@(string.IsNullOrEmpty(Model.PriceRange))"><label class="form-check-label" for="price-all">Tất cả mức giá</label></div>
                        <div class="form-check mb-2"><input class="form-check-input" type="radio" name="priceRange" id="price-under-500" value="under-500" checked="@(Model.PriceRange == "under-500")"><label class="form-check-label" for="price-under-500">Dưới 500.000 ₫</label></div>
                        <div class="form-check mb-2"><input class="form-check-input" type="radio" name="priceRange" id="price-500-to-1500" value="500-to-1500" checked="@(Model.PriceRange == "500-to-1500")"><label class="form-check-label" for="price-500-to-1500">500.000 ₫ - 1.500.000 ₫</label></div>
                        <div class="form-check mb-2"><input class="form-check-input" type="radio" name="priceRange" id="price-over-1500" value="over-1500" checked="@(Model.PriceRange == "over-1500")"><label class="form-check-label" for="price-over-1500">Trên 1.500.000 ₫</label></div>
                    </div>
                    <div class="d-grid gap-2 mt-4"><button class="btn btn-luxury" type="submit">ÁP DỤNG LỌC</button><a asp-action="ListProduct" class="btn btn-link text-muted text-decoration-none small text-center">Đặt lại bộ lọc</a></div>
                </form>

                <div class="filter-card shadow-sm sticky-lg-top d-none" style="top: 100px; z-index: 10;">

                    <!-- Lọc theo Danh mục -->
                    <div class="filter-group mb-4">
                        <h3 class="filter-title">Danh Mục Sản Phẩm</h3>
                        <div class="form-check mb-2 d-flex justify-content-between align-items-center">
                            <div>
                                <input class="form-check-input" type="checkbox" id="cat-1" checked>
                                <label class="form-check-label" for="cat-1">Hoa Quả Nhập Khẩu</label>
                            </div>
                            <span class="category-count">(24)</span>
                        </div>
                        <div class="form-check mb-2 d-flex justify-content-between align-items-center">
                            <div>
                                <input class="form-check-input" type="checkbox" id="cat-2">
                                <label class="form-check-label" for="cat-2">Hộp Quà Biếu Luxury</label>
                            </div>
                            <span class="category-count">(12)</span>
                        </div>
                        <div class="form-check mb-2 d-flex justify-content-between align-items-center">
                            <div>
                                <input class="form-check-input" type="checkbox" id="cat-3">
                                <label class="form-check-label" for="cat-3">Trái Cây Hữu Cơ (Organic)</label>
                            </div>
                            <span class="category-count">(8)</span>
                        </div>
                        <div class="form-check mb-2 d-flex justify-content-between align-items-center">
                            <div>
                                <input class="form-check-input" type="checkbox" id="cat-4">
                                <label class="form-check-label" for="cat-4">Nước Ép Nguyên Chất</label>
                            </div>
                            <span class="category-count">(6)</span>
                        </div>
                    </div>

                    <!-- Lọc theo Xuất xứ -->
                    <div class="filter-group mb-4">
                        <h3 class="filter-title">Xuất Xứ</h3>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="origin-1">
                            <label class="form-check-label" for="origin-1">Nhật Bản (Japan)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="origin-2">
                            <label class="form-check-label" for="origin-2">Hàn Quốc (Korea)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="origin-3">
                            <label class="form-check-label" for="origin-3">Úc (Australia)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="origin-4">
                            <label class="form-check-label" for="origin-4">Mỹ (United States)</label>
                        </div>
                    </div>

                    <!-- Lọc theo Khoảng Giá -->
                    <div class="filter-group mb-4">
                        <h3 class="filter-title">Mức Giá</h3>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="priceRange" id="price-1" checked>
                            <label class="form-check-label" for="price-1">Tất cả mức giá</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="priceRange" id="price-2">
                            <label class="form-check-label" for="price-2">Dưới 500.000 ₫</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="priceRange" id="price-3">
                            <label class="form-check-label" for="price-3">500.000 ₫ - 1.500.000 ₫</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="priceRange" id="price-4">
                            <label class="form-check-label" for="price-4">Trên 1.500.000 ₫</label>
                        </div>
                    </div>

                    <!-- Nút áp dụng / Xóa bộ lọc -->
                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-luxury" type="button">ÁP DỤNG LỌC</button>
                        <button class="btn btn-link text-muted text-decoration-none small text-center" type="button">Đặt lại bộ lọc</button>
                    </div>

                </div>
            </div>

            <!-- PRODUCT LIST AREA -->
            <div class="col-lg-9">

                <!-- Catalog Toolbar (Sắp xếp, Đếm số lượng) -->
                <div class="catalog-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div class="text-muted small">
                        @if (Model.TotalItems > 0)
                        {
                            var firstItem = (Model.Page - 1) * Model.PageSize + 1;
                            var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
                            <span>Hiển thị <strong>@firstItem–@lastItem</strong> trong <strong>@Model.TotalItems</strong> sản phẩm</span>
                        }
                        else
                        {
                            <span>Không tìm thấy sản phẩm phù hợp</span>
                        }
                    </div>

                    <form asp-action="ListProduct" method="get" class="d-flex align-items-center gap-3">
                        <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                        <input type="hidden" name="priceRange" value="@Model.PriceRange" />
                        <label class="small text-nowrap text-muted">Sắp xếp theo:</label>
                        <select name="sort" class="form-select form-select-luxury" onchange="this.form.submit()">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Mới nhất / Theo mùa</option>
                            <option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá: Thấp đến Cao</option>
                            <option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá: Cao đến Thấp</option>
                        </select>
                    </form>
                </div>

                <!-- Products Grid -->
                <div class="row g-4">

                    @foreach (var product in Model.Products)
                    {
                        <div class="col-sm-6 col-md-4">
                            <div class="product-card h-100 d-flex flex-column justify-content-between">
                                @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                                {
                                    <span class="product-badge">@product.CategoryName</span>
                                }
                                <div class="product-img-wrapper">
                                    <img src="@(string.IsNullOrWhiteSpace(product.ImageUrl) ? "https://placehold.co/800x600?text=Fruit+Shop" : product.ImageUrl)" alt="@product.Name">
                                </div>
                                <div class="p-3 text-center flex-grow-1 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="fruit-tag">@(string.IsNullOrWhiteSpace(product.CategoryName) ? "FRUIT SHOP" : product.CategoryName)</span>
                                        <h3 class="h6 font-serif mt-1 mb-2"><a href="#" class="text-decoration-none text-dark">@product.Name</a></h3>
                                        <p class="small text-muted mb-2">@product.Description</p>
                                    </div>
                                    <div class="mt-3">
                                        @if (product.HasExpiryDiscount)
                                        {
                                            <div class="small text-danger fw-semibold mb-1">GIẢM 50% - lô hết hạn ngày @product.SaleBatchExpiryDate?.ToString("dd/MM/yyyy")</div>
                                            <div class="mb-3"><span class="text-muted text-decoration-line-through me-2">@product.Price.ToString("N0") ₫</span><span class="fw-semibold font-serif" style="color: var(--accent-green); font-size: 1.1rem;">@product.SalePrice.ToString("N0") ₫ / @product.Unit</span></div>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold font-serif mb-3" style="color: var(--accent-green); font-size: 1.1rem;">@product.SalePrice.ToString("N0") ₫ / @product.Unit</div>
                                        }
                                        <form asp-controller="Cart" asp-action="Add" method="post" class="batch-selection-form">
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                            <label class="small text-muted text-start d-block mb-1">Chọn lô còn hạn</label>
                                            <select name="inventoryId" class="form-select form-select-sm mb-1 batch-select">
                                                @foreach (var batch in product.SaleBatches)
                                                {
                                                    <option value="@batch.InventoryId" data-price="@batch.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-discount="@batch.HasExpiryDiscount.ToString().ToLowerInvariant()">Lô @batch.BatchCode · HSD @batch.ExpiryDate.ToString("dd/MM/yyyy") · còn @batch.RemainingQuantity @product.Unit@(batch.HasExpiryDiscount ? " · GIẢM 50%" : string.Empty)</option>
                                                }
                                            </select>
                                            <div class="small mb-2 batch-price-preview"></div>
                                            <button class="btn btn-outline-luxury w-100 py-2" type="submit">THÊM VÀO GIỎ</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.Products.Count == 0)
                    {
                        <div class="col-12 text-center py-5 text-muted">Không có sản phẩm phù hợp với bộ lọc đã chọn.</div>
                    }

                </div>

                <!-- Static design samples kept for reference only. -->
                <div class="row g-4 d-none">

                    <!-- Item 1 -->
                    <div class="col-sm-6 col-md-4">
                        <div class="product-card h-100 d-flex flex-column justify-content-between">
                            <span class="product-badge">Air Freight</span>
                            <div class="product-img-wrapper">
                                <img src="https://images.unsplash.com/photo-1537640538966-79f369143f8f?q=80&w=800" alt="Nho Mẫu Đơn">
                            </div>
                            <div class="p-3 text-center flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <span class="fruit-tag">JAPAN OKAYAMA</span>
                                    <h3 class="h6 font-serif mt-1 mb-2"><a href="#" class="text-decoration-none text-dark">Nho Mẫu Đơn Shine Muscat</a></h3>
                                    <p class="small text-muted mb-2">Độ ngọt Brix > 18, vỏ mỏng giòn ngọt thanh mát.</p>
                                </div>
                                <div class="mt-3">
                                    <div class="fw-semibold font-serif mb-3" style="color: var(--accent-green); font-size: 1.1rem;">1.850.000 ₫ / Hộp</div>
                                    <button class="btn btn-outline-luxury w-100 py-2">THÊM VÀO GIỎ</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 2 -->
                    <div class="col-sm-6 col-md-4">
                        <div class="product-card h-100 d-flex flex-column justify-content-between">
                            <span class="product-badge">Exclusive</span>
                            <div class="product-img-wrapper">
                                <img src="https://images.unsplash.com/photo-1528825871115-3581a5387919?q=80&w=800" alt="Cherry Tasmania">
                            </div>
                            <div class="p-3 text-center flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <span class="fruit-tag">AUSTRALIA</span>
                                    <h3 class="h6 font-serif mt-1 mb-2"><a href="#" class="text-decoration-none text-dark">Cherry Đỏ Size 32+ Premium</a></h3>
                                    <p class="small text-muted mb-2">Thịt giòn mọng nước, cuống tươi nguyên từ vườn.</p>
                                </div>
                                <div class="mt-3">
                                    <div class="fw-semibold font-serif mb-3" style="color: var(--accent-green); font-size: 1.1rem;">920.000 ₫ / Kg</div>
                                    <button class="btn btn-outline-luxury w-100 py-2">THÊM VÀO GIỎ</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 3 -->
                    <div class="col-sm-6 col-md-4">
                        <div class="product-card h-100 d-flex flex-column justify-content-between">
                            <span class="product-badge">Limited</span>
                            <div class="product-img-wrapper">
                                <img src="https://images.unsplash.com/photo-1601004890684-d8cbf643f5f2?q=80&w=800" alt="Dâu Tây Tuyết">
                            </div>
                            <div class="p-3 text-center flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <span class="fruit-tag">KOREA SANCHEOK</span>
                                    <h3 class="h6 font-serif mt-1 mb-2"><a href="#" class="text-decoration-none text-dark">Dâu Tây Tuyết Seolhyang</a></h3>
                                    <p class="small text-muted mb-2">Hương thơm trái dâu chín mọng, vị ngọt thanh tự nhiên.</p>
                                </div>
                                <div class="mt-3">
                                    <div class="fw-semibold font-serif mb-3" style="color: var(--accent-green); font-size: 1.1rem;">650.000 ₫ / Hộp</div>
                                    <button class="btn btn-outline-luxury w-100 py-2">THÊM VÀO GIỎ</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 4 -->
                    <div class="col-sm-6 col-md-4">
                        <div class="product-card h-100 d-flex flex-column justify-content-between">
                            <div class="product-img-wrapper">
                                <img src="https://images.unsplash.com/photo-1557800636-894a64c1696f?q=80&w=800" alt="Cam Vàng Cara">
                            </div>
                            <div class="p-3 text-center flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <span class="fruit-tag">USA CALIFORNIA</span>
                                    <h3 class="h6 font-serif mt-1 mb-2"><a href="#" class="text-decoration-none text-dark">Cam Ruột Đỏ Cara Cara</a></h3>
                                    <p class="small text-muted mb-2">Giàu Vitamin C, vị ngọt đậm không chua hạt mỏng.</p>
                                </div>
                                <div class="mt-3">
                                    <div class="fw-semibold font-serif mb-3" style="color: var(--accent-green); font-size: 1.1rem;">380.000 ₫ / Kg</div>
                                    <button class="btn btn-outline-luxury w-100 py-2">THÊM VÀO GIỎ</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 5 -->
                    <div class="col-sm-6 col-md-4">
                        <div class="product-card h-100 d-flex flex-column justify-content-between">
                            <span class="product-badge">Top Seller</span>
                            <div class="product-img-wrapper">
                                <img src="https://images.unsplash.com/photo-1560806887-1e4cd0b6cbd6?q=80&w=800" alt="Táo Envy">
                            </div>
                            <div class="p-3 text-center flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <span class="fruit-tag">NEW ZEALAND</span>
                                    <h3 class="h6 font-serif mt-1 mb-2"><a href="#" class="text-decoration-none text-dark">Táo Envy Size 24 High-Grade</a></h3>
                                    <p class="small text-muted mb-2">Thịt táo đậm đặc, thơm nức, độ giòn hoàn hảo.</p>
                                </div>
                                <div class="mt-3">
                                    <div class="fw-semibold font-serif mb-3" style="color: var(--accent-green); font-size: 1.1rem;">420.000 ₫ / Kg</div>
                                    <button class="btn btn-outline-luxury w-100 py-2">THÊM VÀO GIỎ</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Item 6 -->
                    <div class="col-sm-6 col-md-4">
                        <div class="product-card h-100 d-flex flex-column justify-content-between">
                            <span class="product-badge">Boutique Box</span>
                            <div class="product-img-wrapper">
                                <img src="https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?q=80&w=800" alt="Hộp Quà Thượng Hạng">
                            </div>
                            <div class="p-3 text-center flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <span class="fruit-tag">GIFT COLLECTION</span>
                                    <h3 class="h6 font-serif mt-1 mb-2"><a href="#" class="text-decoration-none text-dark">Hộp Quà VIP Le Fruit Privé</a></h3>
                                    <p class="small text-muted mb-2">Kết hợp 5 loại hoa quả hàng không đắt giá nhất.</p>
                                </div>
                                <div class="mt-3">
                                    <div class="fw-semibold font-serif mb-3" style="color: var(--accent-green); font-size: 1.1rem;">2.500.000 ₫ / Hộp</div>
                                    <button class="btn btn-outline-luxury w-100 py-2">THÊM VÀO GIỎ</button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Pagination (Phân trang) -->
                @if (Model.TotalPages > 1)
                {
                <nav class="mt-5 d-flex justify-content-center">
                    <ul class="pagination pagination-luxury">
                        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="ListProduct" asp-route-categoryId="@Model.CategoryId" asp-route-priceRange="@Model.PriceRange" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page - 1)"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @for (var currentPage = 1; currentPage <= Model.TotalPages; currentPage++)
                        {
                            <li class="page-item @(currentPage == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="ListProduct" asp-route-categoryId="@Model.CategoryId" asp-route-priceRange="@Model.PriceRange" asp-route-sort="@Model.Sort" asp-route-page="@currentPage">@currentPage</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="ListProduct" asp-route-categoryId="@Model.CategoryId" asp-route-priceRange="@Model.PriceRange" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page + 1)"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
                }

            </div>

        </div>
    </div>
</section>
<script>
document.querySelectorAll('.batch-selection-form').forEach(function (form) {
    const select = form.querySelector('.batch-select');
    const preview = form.querySelector('.batch-price-preview');
    const render = function () {
        const option = select.options[select.selectedIndex];
        const price = Number(option.dataset.price).toLocaleString('vi-VN') + ' ₫';
        preview.textContent = option.dataset.discount === 'true' ? 'Giá lô đã chọn: ' + price + ' (giảm 50%)' : 'Giá lô đã chọn: ' + price;
        preview.className = 'small mb-2 batch-price-preview ' + (option.dataset.discount === 'true' ? 'text-danger fw-semibold' : 'text-muted');
    };
    select.addEventListener('change', render); render();
});
</script>
