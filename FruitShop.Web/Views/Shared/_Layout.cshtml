@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");
    var cartItemCount = 0; // Will be populated dynamically by cart service if available
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Le Fruit Boutique</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-cream: #F9F6F0;
            --text-main: #2C2A29;
            --accent-gold: #C5A880;
            --accent-green: #275D38;
            --font-heading: 'Cormorant Garamond', serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-cream);
            color: var(--text-main);
            font-family: var(--font-body);
            font-weight: 300;
            letter-spacing: 0.02em;
        }

        h1, h2, h3, h4, .font-serif {
            font-family: var(--font-heading);
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .top-bar {
            background-color: var(--bg-cream);
            border-bottom: 1px solid rgba(197, 168, 128, 0.2);
            font-size: 0.8rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .navbar {
            background-color: var(--bg-cream) !important;
            padding: 1.2rem 0;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-family: var(--font-heading);
            font-size: 2rem;
            letter-spacing: 0.15em;
            color: var(--text-main) !important;
            text-transform: uppercase;
        }

        .nav-link {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--text-main) !important;
            margin: 0 0.5rem;
            position: relative;
            transition: color 0.3s;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: -2px;
            left: 50%;
            background-color: var(--accent-gold);
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .btn-luxury {
            background-color: var(--accent-green);
            color: #fff;
            border: none;
            padding: 0.8rem 2rem;
            font-size: 0.8rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            border-radius: 0;
            transition: all 0.3s ease;
        }

        .btn-luxury:hover {
            background-color: var(--accent-gold);
            color: #fff;
        }

        footer {
            background-color: #F3EFEA;
            border-top: 1px solid rgba(197, 168, 128, 0.3);
            padding: 4rem 0 2rem 0;
        }

        .footer-heading {
            font-size: 1.2rem;
            color: var(--text-main);
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="top-bar py-2 text-center text-muted">
        <span><i class="bi bi-geo-alt me-1"></i> Dịch vụ Concierge Giao Hàng Tận Nơi 24/7</span>
        <span class="mx-3">|</span>
        <span><i class="bi bi-telephone me-1"></i> Hotline Ưu Tiên: 1800 8888</span>
    </div>

    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg border-bottom">
            <div class="container">
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="ListProduct">Bộ Sưu Tập</a>
                        </li>
                    </ul>

                    <a class="navbar-brand mx-auto text-center d-none d-lg-block" asp-controller="Home" asp-action="Index">
                        LE FRUIT<br><span style="font-size: 0.6rem; letter-spacing: 0.4em; display: block; margin-top: -8px;">BOUTIQUE</span>
                    </a>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng">
                                <i class="bi bi-bag fs-5"></i>
                            </a>
                        </li>

                        @if (!string.IsNullOrEmpty(username))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle font-weight-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: #275D38 !important;">
                                    <i class="bi bi-person-circle me-1"></i> @(string.IsNullOrEmpty(fullName) ? username : fullName)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-person me-1"></i> Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4 text-center text-md-start">
                    <h3 class="footer-heading font-serif">LE FRUIT BOUTIQUE</h3>
                    <p class="small text-muted">Trải nghiệm thưởng thức hoa quả chuẩn phong cách nghỉ dưỡng 5 sao. Từng quả ngọt đều được tuyển chọn bởi nghệ nhân.</p>
                </div>
                <div class="col-md-4 text-center">
                    <h4 class="footer-heading font-serif">DỊCH VỤ KHÁCH HÀNG</h4>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Đặt Giỏ Quà Private</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Quyền Lợi Hội Viên Member</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Chính Sách Bảo Quản</a></li>
                    </ul>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <h4 class="footer-heading font-serif">BẢN TIN PRIVÉ</h4>
                    <p class="small text-muted">Đăng ký nhận thông báo về các lô hoa quả giới hạn mùa này.</p>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control rounded-0 border-end-0" placeholder="Email của quý khách..." style="background: transparent;">
                        <button class="btn btn-luxury" type="button">GỬI</button>
                    </div>
                </div>
            </div>
            <div class="text-center pt-4 border-top mt-4 small text-muted">
                &copy; 2026 - LE FRUIT BOUTIQUE - ALL RIGHTS RESERVED.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
