@model FruitShop.Shared.Contracts.RegisterRequest
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container mt-4" style="max-width: 550px;">
    <div class="card shadow-sm border-0 rounded-lg">
        <div class="card-body p-4">
            <h3 class="text-center font-weight-bold mb-4" style="color: #275D38;">Đăng Ký Tài Khoản Mới</h3>
            
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group mb-3">
                    <label class="form-label font-weight-bold">Họ và Tên (*)</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên" required />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label font-weight-bold">Tên đăng nhập (*)</label>
                    <input asp-for="Username" class="form-control" placeholder="Nhập username" required />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label font-weight-bold">Mật khẩu (*)</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" required />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label font-weight-bold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="nhapemail@example.com" />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label font-weight-bold">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" placeholder="0901234567" />
                </div>
                <div class="form-group mb-4">
                    <label class="form-label font-weight-bold">Địa chỉ giao hàng</label>
                    <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ nhận hàng" />
                </div>
                <button type="submit" class="btn btn-success btn-block w-100 py-2" style="background-color: #275D38; border: none;">Đăng Ký Tài Khoản</button>
            </form>
            <div class="text-center mt-3">
                <span>Đã có tài khoản? </span>
                <a asp-action="Login" style="color: #275D38; font-weight: bold;">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>
