<Window x:Class="FruitShop.Client.InventoryBatchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory import history" Height="540" Width="980" WindowStartupLocation="CenterOwner" Background="#F5F7F4">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TitleTextBlock" FontSize="26" FontWeight="SemiBold" Foreground="#1D2A20" /><TextBlock Text="Import history is ordered from the most recent batch to the oldest." Margin="0,7,0,0" Foreground="#66706A" /></StackPanel>
        <TextBlock Grid.Row="1" x:Name="StatusTextBlock" Margin="0,20,0,12" Foreground="#275D38" />
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E0E6E1" BorderThickness="1" Padding="10">
            <DataGrid x:Name="BatchesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Lô (Batch)" Binding="{Binding BatchCode}" Width="*" />
                    <DataGridTextColumn Header="Chi Nhánh" Binding="{Binding BranchName}" Width="160" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Đã Nhập" Binding="{Binding QuantityReceived}" Width="90" />
                    <DataGridTextColumn Header="Còn Lại" Binding="{Binding RemainingQuantity}" Width="90" FontWeight="Bold" />
                    <DataGridTextColumn Header="Ngày Nhập" Binding="{Binding ReceivedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                    <DataGridTextColumn Header="Hạn Sử Dụng" Binding="{Binding ExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                    <DataGridTextColumn Header="Nhà Cung Cấp" Binding="{Binding SupplierName}" Width="*" />
                    <DataGridTextColumn Header="Giá Nhập (đ)" Binding="{Binding UnitCost, StringFormat={}{0:N0}}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
