<Window x:Class="FruitShop.Client.UpdateStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập Kho Lô Hàng Tồn" Height="730" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F7F4">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Nhập Lô Kho Cho Sản Phẩm" FontSize="22" FontWeight="SemiBold" Foreground="#1D2A20" />
            <TextBlock Text="Tạo lô hàng mới có hạn sử dụng và giá bán riêng cho lô" Margin="0,4,0,0" Foreground="#66706A" FontSize="13" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Chọn sản phẩm" FontWeight="SemiBold" />
            <ComboBox x:Name="ProductComboBox" Margin="0,6,0,0" Height="38" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="8,4" SelectionChanged="ProductComboBox_SelectionChanged" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Chọn chi nhánh nhập kho" FontWeight="SemiBold" />
            <ComboBox x:Name="BranchComboBox" Margin="0,6,0,0" Height="38" DisplayMemberPath="BranchName" SelectedValuePath="Id" Padding="8,4" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Mã lô hàng (Batch Code)" FontWeight="SemiBold" />
            <TextBox x:Name="BatchCodeTextBox" Margin="0,6,0,0" Height="38" Padding="10,8" Text="BATCH-20260817" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Số lượng nhập" FontWeight="SemiBold" />
            <TextBox x:Name="StockTextBox" Margin="0,6,0,0" Height="38" Padding="10,8" Text="50" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock Text="Nhà cung cấp" FontWeight="SemiBold" />
            <TextBox x:Name="SupplierNameTextBox" Margin="0,6,0,0" Height="38" Padding="10,8" VerticalContentAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Giá nhập / Vốn (đ)" FontWeight="SemiBold" />
                <TextBox x:Name="UnitCostTextBox" Margin="0,6,0,0" Height="38" Padding="10,8" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Giá bán ra (đ) *" FontWeight="SemiBold" />
                <TextBox x:Name="SellingPriceTextBox" Margin="0,6,0,0" Height="38" Padding="10,8" VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="7" Margin="0,12,0,0">
            <TextBlock Text="Hạn sử dụng (Expiry Date)" FontWeight="SemiBold" />
            <DatePicker x:Name="ExpiryDatePicker" Margin="0,6,0,0" Height="38" />
        </StackPanel>

        <TextBlock Grid.Row="8" x:Name="StatusTextBlock" Margin="0,10,0,0" MinHeight="24" TextWrapping="Wrap" Foreground="#B42318" />

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Hủy bỏ" Width="100" Height="38" Margin="0,0,10,0" Click="CancelButton_Click" Background="Transparent" Foreground="#275D38" BorderBrush="#275D38" Cursor="Hand" />
            <Button x:Name="SaveButton" Content="Nhập lô kho" Width="130" Height="38" Click="SaveButton_Click" Background="#275D38" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>