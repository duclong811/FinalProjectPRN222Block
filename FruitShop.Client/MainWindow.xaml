<Window x:Class="FruitShop.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FruitShop Admin" Height="580" Width="940"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F7F7F2">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Background="#275D38" Padding="54">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Le Fruit" FontSize="42" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="ADMIN PORTAL" Margin="2,6,0,28" FontSize="13" FontWeight="SemiBold" Foreground="#C8E6C9" />
                <TextBlock Text="Manage your fruit shop&#x0a;from one simple place." FontSize="25" FontWeight="SemiBold" Foreground="White" LineHeight="37" />
                <Border Margin="0,40,0,0" Padding="18" Background="#FFFFFF22" CornerRadius="12">
                    <TextBlock Text="Sign in with an active administrator account, or register a new local admin account." TextWrapping="Wrap" FontSize="15" Foreground="#E8F5E9" LineHeight="24" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="64,0">
            <StackPanel x:Name="LoginPanel" VerticalAlignment="Center">
                <TextBlock Text="Welcome back" FontSize="29" FontWeight="SemiBold" Foreground="#252525" />
                <TextBlock Text="Sign in to manage FruitShop." Margin="0,8,0,30" FontSize="14" Foreground="#666666" />
                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#3F3F3F" />
                <TextBox x:Name="UsernameTextBox" Margin="0,8,0,18" Height="42" Padding="12,8" FontSize="15" VerticalContentAlignment="Center" />
                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#3F3F3F" />
                <PasswordBox x:Name="PasswordBox" Margin="0,8,0,12" Height="42" Padding="12,8" FontSize="15" VerticalContentAlignment="Center" KeyDown="PasswordBox_KeyDown" />
                <TextBlock x:Name="StatusTextBlock" MinHeight="24" TextWrapping="Wrap" Foreground="#B42318" />
                <Button x:Name="LoginButton" Content="Sign in" Height="44" Margin="0,10,0,0" Click="LoginButton_Click" Background="#275D38" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="Create an administrator account" Margin="0,12,0,0" Click="ShowRegister_Click" Background="Transparent" Foreground="#275D38" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>

            <StackPanel x:Name="RegisterPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Create administrator" FontSize="29" FontWeight="SemiBold" Foreground="#252525" />
                <TextBlock Text="The new account is immediately active." Margin="0,8,0,22" FontSize="14" Foreground="#666666" />
                <TextBlock Text="Full name" FontWeight="SemiBold" Foreground="#3F3F3F" />
                <TextBox x:Name="FullNameTextBox" Margin="0,6,0,12" Height="38" Padding="12,7" FontSize="14" VerticalContentAlignment="Center" />
                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#3F3F3F" />
                <TextBox x:Name="RegisterUsernameTextBox" Margin="0,6,0,12" Height="38" Padding="12,7" FontSize="14" VerticalContentAlignment="Center" />
                <TextBlock Text="Password (at least 8 characters)" FontWeight="SemiBold" Foreground="#3F3F3F" />
                <PasswordBox x:Name="RegisterPasswordBox" Margin="0,6,0,12" Height="38" Padding="12,7" FontSize="14" VerticalContentAlignment="Center" />
                <TextBlock Text="Confirm password" FontWeight="SemiBold" Foreground="#3F3F3F" />
                <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,6,0,8" Height="38" Padding="12,7" FontSize="14" VerticalContentAlignment="Center" KeyDown="ConfirmPasswordBox_KeyDown" />
                <TextBlock x:Name="RegisterStatusTextBlock" MinHeight="24" TextWrapping="Wrap" Foreground="#B42318" />
                <Button x:Name="RegisterButton" Content="Create account" Height="44" Margin="0,6,0,0" Click="RegisterButton_Click" Background="#275D38" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="Back to sign in" Margin="0,10,0,0" Click="ShowLogin_Click" Background="Transparent" Foreground="#275D38" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
