<Window x:Class="FruitShop.Client.RevenueReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FruitShop - Tổng Hợp Báo Cáo Doanh Thu &amp; Hàng Bán Chạy" 
        Height="780" Width="1240"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterOwner" 
        Background="#F4F7F4">
    <Window.Resources>
        <!-- Modern Primary Button -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F4D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D6A44"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#153822"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Secondary Button -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F4D30"/>
            <Setter Property="BorderBrush" Value="#C2D6C6"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F7F2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F4D30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2EDE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Card Base Style -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#10000000" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Filter Bar -->
            <RowDefinition Height="Auto" /> <!-- KPI Summary Cards -->
            <RowDefinition Height="*" />    <!-- Content Tabs (Best Sellers & Branch Breakdown) -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER & FILTER BAR -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="#E2E8E3" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <!-- Action Controls on the Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Branch Filter -->
                    <Border Background="#F8FAF8" BorderBrush="#C2D6C6" BorderThickness="1.2" CornerRadius="8" Padding="10,0,8,0" Margin="0,0,10,0" Height="38">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏢 Cơ sở:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#1F4D30" FontSize="13"/>
                            <ComboBox x:Name="BranchFilterComboBox" Width="210" Height="30" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" DisplayMemberPath="BranchName" SelectedValuePath="Id" SelectionChanged="Filter_SelectionChanged" FontSize="13" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Time Range Preset -->
                    <Border Background="#F8FAF8" BorderBrush="#C2D6C6" BorderThickness="1.2" CornerRadius="8" Padding="10,0,8,0" Margin="0,0,10,0" Height="38">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅 Kỳ:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#1F4D30" FontSize="13"/>
                            <ComboBox x:Name="TimePeriodComboBox" Width="135" Height="30" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" SelectionChanged="TimePeriodComboBox_SelectionChanged" FontSize="13" Cursor="Hand">
                                <ComboBoxItem Content="Tháng này" Tag="THIS_MONTH"/>
                                <ComboBoxItem Content="Hôm nay" Tag="TODAY"/>
                                <ComboBoxItem Content="7 ngày qua" Tag="LAST_7_DAYS"/>
                                <ComboBoxItem Content="Tháng trước" Tag="LAST_MONTH"/>
                                <ComboBoxItem Content="Toàn thời gian" Tag="ALL_TIME"/>
                                <ComboBoxItem Content="Tùy chọn..." Tag="CUSTOM"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Custom Date Pickers (Visible when Custom is selected or always available) -->
                    <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <DatePicker x:Name="FromDatePicker" Width="115" Height="36" SelectedDateChanged="DatePicker_SelectedDateChanged" Margin="0,0,6,0" ToolTip="Từ ngày"/>
                        <TextBlock Text="➔" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#6B7280" FontWeight="Bold"/>
                        <DatePicker x:Name="ToDatePicker" Width="115" Height="36" SelectedDateChanged="DatePicker_SelectedDateChanged" Margin="0,0,10,0" ToolTip="Đến ngày"/>
                    </StackPanel>

                    <!-- Refresh Button -->
                    <Button Style="{StaticResource ModernPrimaryButton}" Content="🔄 Lấy Báo Cáo" Click="RefreshReportButton_Click" Padding="16,0"/>
                </StackPanel>

                <!-- Titles on Left -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Báo Cáo Tổng Hợp Doanh Thu &amp; Hàng Bán Chạy" FontSize="22" FontWeight="Bold" Foreground="#1D2A20"/>
                    <TextBlock x:Name="FilterSummaryTextBlock" Text="Tổng quan toàn bộ hệ thống các cơ sở và chi tiết từng chi nhánh" Margin="0,3,0,0" Foreground="#5A665E" FontSize="12.5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. KPI SUMMARY CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/> <!-- Total Revenue -->
                <ColumnDefinition Width="*"/>   <!-- Completed Orders -->
                <ColumnDefinition Width="*"/>   <!-- Items Sold -->
                <ColumnDefinition Width="*"/>   <!-- Average Order Value -->
                <ColumnDefinition Width="0.9*"/> <!-- Cancelled Orders -->
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Revenue -->
            <Border Grid.Column="0" Style="{StaticResource KpiCard}" Background="#1F4D30">
                <StackPanel>
                    <TextBlock Text="💰 TỔNG DOANH THU" Foreground="#B8D8BF" FontSize="11.5" FontWeight="Bold"/>
                    <TextBlock x:Name="TotalRevenueTextBlock" Text="0 đ" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock Text="Đơn hàng đã hoàn tất" Foreground="#D1E7D6" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Completed Orders -->
            <Border Grid.Column="1" Style="{StaticResource KpiCard}" Background="White" BorderBrush="#E2E8E3" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📦 ĐƠN HOÀN THÀNH" Foreground="#047857" FontSize="11.5" FontWeight="Bold"/>
                    <TextBlock x:Name="TotalOrdersTextBlock" Text="0" Foreground="#065F46" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock Text="Giao thành công &amp; đã thu tiền" Foreground="#6B7280" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Items Sold -->
            <Border Grid.Column="2" Style="{StaticResource KpiCard}" Background="White" BorderBrush="#E2E8E3" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🏷️ TỔNG SẢN LƯỢNG BÁN" Foreground="#0284C7" FontSize="11.5" FontWeight="Bold"/>
                    <TextBlock x:Name="TotalItemsSoldTextBlock" Text="0" Foreground="#0369A1" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock Text="Số kg / hộp đã tiêu thụ" Foreground="#6B7280" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Average Order Value -->
            <Border Grid.Column="3" Style="{StaticResource KpiCard}" Background="White" BorderBrush="#E2E8E3" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🛒 GIÁ TRỊ TB / ĐƠN" Foreground="#B45309" FontSize="11.5" FontWeight="Bold"/>
                    <TextBlock x:Name="AverageOrderValueTextBlock" Text="0 đ" Foreground="#92400E" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock Text="Doanh thu / Đơn hoàn tất" Foreground="#6B7280" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Card 5: Cancelled Orders -->
            <Border Grid.Column="4" Style="{StaticResource KpiCard}" Background="White" BorderBrush="#E2E8E3" BorderThickness="1" Margin="0">
                <StackPanel>
                    <TextBlock Text="❌ ĐƠN ĐÃ HỦY" Foreground="#DC2626" FontSize="11.5" FontWeight="Bold"/>
                    <TextBlock x:Name="CancelledOrdersTextBlock" Text="0" Foreground="#991B1B" FontSize="22" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock Text="Đơn hủy / không thành công" Foreground="#6B7280" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. DATA TABLES (Tabs: Best Sellers vs Branch Breakdown) -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E2E8E3" BorderThickness="1" Padding="16">
            <TabControl BorderThickness="0" Background="Transparent">
                <!-- Tab 1: Top Sản Phẩm Bán Chạy -->
                <TabItem Header="  🏆 Top Hàng Bán Chạy (Best Sellers)  " FontSize="13.5" FontWeight="SemiBold" Cursor="Hand">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search and Quick Filter in Best Sellers Tab -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Xếp hạng mặt hàng theo số lượng bán và chi tiết số lượng tại từng cơ sở:" VerticalAlignment="Center" Foreground="#4B5563" FontSize="12.5"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox x:Name="ProductSearchTextBox" Width="240" Height="34" Padding="10,0" VerticalContentAlignment="Center" TextChanged="ProductSearchTextBox_TextChanged" Text="🔍 Tìm sản phẩm..." Foreground="#9CA3AF" GotFocus="ProductSearchTextBox_GotFocus" LostFocus="ProductSearchTextBox_LostFocus"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Best Sellers DataGrid -->
                        <DataGrid x:Name="BestSellersDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="48" AlternatingRowBackground="#F9FAF9" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hạng" Binding="{Binding Rank, StringFormat={}#{0}}" Width="65" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="2*" MinWidth="180" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="*" MinWidth="110"/>
                                <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="75"/>
                                <DataGridTextColumn Header="Tổng SL bán" Binding="{Binding TotalQuantitySold, StringFormat={}{0:N0}}" Width="110" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Tổng Doanh thu (đ)" Binding="{Binding TotalRevenue, StringFormat={}{0:N0}}" Width="150" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Giá bán TB (đ)" Binding="{Binding AveragePrice, StringFormat={}{0:N0}}" Width="120"/>
                                <DataGridTextColumn Header="Phân rã số lượng theo từng cơ sở (Branch Breakdown)" Binding="{Binding BranchBreakdown}" Width="3*" MinWidth="260"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Doanh Thu Theo Từng Cơ Sở (Branch Breakdown) -->
                <TabItem Header="  🏢 Doanh Thu Theo Từng Cơ Sở  " FontSize="13.5" FontWeight="SemiBold" Cursor="Hand">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="So sánh hiệu quả kinh doanh, số đơn và tỷ trọng doanh thu đóng góp giữa các chi nhánh:" Margin="0,0,0,10" Foreground="#4B5563" FontSize="12.5"/>

                        <!-- Branch Breakdown DataGrid -->
                        <DataGrid x:Name="BranchBreakdownDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="48" AlternatingRowBackground="#F9FAF9" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã cơ sở" Binding="{Binding BranchId}" Width="90"/>
                                <DataGridTextColumn Header="Tên Cơ Sở / Chi Nhánh" Binding="{Binding BranchName}" Width="2*" MinWidth="220" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Số đơn hoàn tất" Binding="{Binding TotalCompletedOrders, StringFormat={}{0:N0} đơn}" Width="150" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Tổng doanh thu (đ)" Binding="{Binding TotalRevenue, StringFormat={}{0:N0} đ}" Width="190" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Tỷ trọng (%)" Binding="{Binding RevenuePercentage, StringFormat={}{0:N1} %}" Width="130" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Giá trị TB / Đơn (đ)" Binding="{Binding AverageOrderValue, StringFormat={}{0:N0} đ}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 4. STATUS BAR -->
        <DockPanel Grid.Row="3" Margin="4,10,4,0">
            <TextBlock x:Name="StatusTextBlock" Text="Sẵn sàng." Foreground="#275D38" FontWeight="Medium" FontSize="12"/>
            <Button Content="Đóng" Click="CloseButton_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="16,4" Background="#E5E7EB" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
