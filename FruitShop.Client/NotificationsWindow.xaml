<Window x:Class="FruitShop.Client.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trung Tâm Thông Báo - FruitShop" Height="620" Width="760"
        WindowStartupLocation="CenterOwner" Background="#F5F7F4">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="🔔 Trung Tâm Thông Báo" FontSize="24" FontWeight="Bold" Foreground="#1D2A20"/>
                <TextBlock Text="Cảnh báo tồn kho, nhắc nhở nhập thêm hàng và thông tin vận hành" FontSize="13" Foreground="#59635B" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Tải lại" Click="RefreshButton_Click" Width="90" Height="36" Background="#E2E8F0" Foreground="#1D2A20" BorderBrush="Transparent" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="✓ Đánh dấu tất cả đã đọc" Click="MarkAllReadButton_Click" Height="36" Padding="12,0" Background="#1F4D30" Foreground="White" BorderBrush="Transparent" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <!-- Status & Filter bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <TextBlock x:Name="BranchFilterTextBlock" Text="Chi nhánh: Đang tải..." VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#1D2A20"/>
                <TextBlock x:Name="StatusTextBlock" Text="" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#26733A" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Notifications List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyTextBlock" Text="🎉 Không có thông báo nào." HorizontalAlignment="Center" Margin="0,40,0,0" FontSize="15" Foreground="#718096" Visibility="Collapsed"/>
                
                <ItemsControl x:Name="NotificationsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" BorderThickness="1.5" Margin="0,0,0,12" Padding="16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                <Setter Property="BorderBrush" Value="#22C55E"/>
                                                <Setter Property="Background" Value="#F4FBF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Icon + Title + Branch + Time + Unread Badge -->
                                    <DockPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="#1D2A20" VerticalAlignment="Center"/>
                                            <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BranchName}" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Border Background="#EF4444" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="MỚI" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Message Body -->
                                    <TextBlock Grid.Row="1" Text="{Binding Message}" FontSize="13.5" Foreground="#2D3748" Margin="0,10,0,12" TextWrapping="Wrap" LineHeight="20"/>

                                    <!-- Action Buttons -->
                                    <DockPanel Grid.Row="2">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="⚡ Nhập Hàng Ngay" Click="QuickRestockButton_Click" Tag="{Binding}" Height="30" Padding="12,0" Background="#1F4D30" Foreground="White" BorderBrush="Transparent" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Margin="0,0,8,0"/>
                                            <Button Content="Đã đọc" Click="MarkReadButton_Click" Tag="{Binding Id}" Height="30" Padding="10,0" Background="#EDF2F7" Foreground="#4A5568" BorderBrush="Transparent" FontSize="12" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Đóng" Click="CloseButton_Click" Width="100" Height="36" DockPanel.Dock="Right" Background="#CBD5E0" Foreground="#2D3748" BorderBrush="Transparent" FontWeight="SemiBold" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
