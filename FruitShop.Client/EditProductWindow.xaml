<Window x:Class="FruitShop.Client.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa sản phẩm" Height="620" Width="640" WindowStartupLocation="CenterOwner"
        Background="#F5F7F4" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Chỉnh sửa thông tin sản phẩm" FontSize="26" FontWeight="Bold" Foreground="#1D2A20" /><TextBlock x:Name="ProductCodeTextBlock" Margin="0,4,0,0" Foreground="#66706A" /></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0"><StackPanel>
            <TextBlock Text="Tên sản phẩm *" FontWeight="SemiBold" /><TextBox x:Name="NameTextBox" Margin="0,6,0,14" Height="38" Padding="10,7" FontSize="13" VerticalContentAlignment="Center" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Danh mục sản phẩm *" FontWeight="SemiBold" /><ComboBox x:Name="CategoryComboBox" DisplayMemberPath="Name" Margin="0,6,0,0" Height="38" Padding="8" FontSize="13" VerticalContentAlignment="Center" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Đơn vị tính *" FontWeight="SemiBold" /><TextBox x:Name="UnitTextBox" Margin="0,6,0,0" Height="38" Padding="10,7" FontSize="13" VerticalContentAlignment="Center" /></StackPanel>
            </Grid>
            <TextBlock Text="Mô tả sản phẩm" FontWeight="SemiBold" /><TextBox x:Name="DescriptionTextBox" Margin="0,6,0,14" Height="80" Padding="10,7" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="13" />
            <CheckBox x:Name="ReplaceImageCheckBox" Content="Thay đổi hoặc cập nhật ảnh mới" Margin="0,0,0,8" Checked="ReplaceImageCheckBox_Changed" Unchecked="ReplaceImageCheckBox_Changed" />
            <Grid x:Name="ImageSelectionGrid" Visibility="Collapsed" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><TextBox x:Name="ImagePathTextBox" IsReadOnly="True" Height="38" Padding="10,7" VerticalContentAlignment="Center" FontSize="13" /><Button Grid.Column="1" Content="Chọn ảnh..." Margin="10,0,0,0" Click="ChooseImageButton_Click" Background="#FFFFFF" Foreground="#1F4D30" BorderBrush="#1F4D30" FontWeight="SemiBold" Cursor="Hand" Height="38" /></Grid>
            <TextBlock x:Name="StatusTextBlock" MinHeight="24" TextWrapping="Wrap" Foreground="#B42318" FontWeight="Medium" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,10"><Button Content="Hủy" Width="100" Height="40" Margin="0,0,12,0" Click="CancelButton_Click" Background="Transparent" Foreground="#1F4D30" BorderBrush="#C2D6C6" BorderThickness="1.2" FontWeight="SemiBold" Cursor="Hand" /><Button x:Name="SaveButton" Content="Lưu thay đổi" Width="140" Height="40" Click="SaveButton_Click" Background="#1F4D30" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" /></StackPanel>
        </StackPanel></ScrollViewer>
    </Grid>
</Window>
