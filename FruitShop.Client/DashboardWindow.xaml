<Window x:Class="FruitShop.Client.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FruitShop Control Center" Height="700" Width="1180"
        WindowStartupLocation="CenterScreen" Background="#F5F7F4">
    <Window.Resources>
        <!-- Modern Primary Button Style -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F4D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D6A44"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#153822"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Secondary / Outline Button Style -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F4D30"/>
            <Setter Property="BorderBrush" Value="#C2D6C6"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F7F2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F4D30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2EDE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Icon Button Style -->
        <Style x:Key="ModernIconButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C2D6C6"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F7F2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F4D30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2EDE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#1F4D30" Padding="22">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Le Fruit" FontSize="30" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="DashboardSubtitleTextBlock" Text="CONTROL CENTER" Margin="1,2,0,36" FontSize="11" FontWeight="SemiBold" Foreground="#B8D8BF" />

                    <Button x:Name="UsersNavigationButton" Content="Quản lý tài khoản" Height="44" HorizontalContentAlignment="Left" Padding="14,0" Margin="0,0,0,8" Click="UsersNavigationButton_Click" Background="Transparent" Foreground="#E6F2E8" BorderBrush="Transparent" FontSize="14" Cursor="Hand" Visibility="Collapsed" />
                    <Button x:Name="BranchesNavigationButton" Content="Quản lý chi nhánh" Height="44" HorizontalContentAlignment="Left" Padding="14,0" Margin="0,0,0,8" Click="BranchesNavigationButton_Click" Background="Transparent" Foreground="#E6F2E8" BorderBrush="Transparent" FontSize="14" Cursor="Hand" Visibility="Collapsed" />
                    <Button x:Name="ProductsNavigationButton" Content="Quản lý sản phẩm" Height="46" HorizontalContentAlignment="Left" Padding="14,0" Click="ProductsNavigationButton_Click" Background="#39704A" Foreground="White" BorderBrush="Transparent" FontSize="14" FontWeight="SemiBold" Cursor="Hand" />
                    <Button x:Name="InventoryNavigationButton" Content="Quản lý kho" Height="44" HorizontalContentAlignment="Left" Padding="14,0" Margin="0,8,0,0" Click="InventoryNavigationButton_Click" Background="Transparent" Foreground="#E6F2E8" BorderBrush="Transparent" FontSize="14" Cursor="Hand" />
                    <Button x:Name="OrdersNavigationButton" Content="Quản lý đơn hàng" Height="44" HorizontalContentAlignment="Left" Padding="14,0" Margin="0,8,0,0" Click="OrdersNavigationButton_Click" Background="Transparent" Foreground="#E6F2E8" BorderBrush="Transparent" FontSize="14" Cursor="Hand" />
                    <Button x:Name="ExpiryNavigationButton" Content="Hàng sắp hết hạn" Height="44" HorizontalContentAlignment="Left" Padding="14,0" Margin="0,8,0,0" Click="ExpiryNavigationButton_Click" Background="Transparent" Foreground="#E6F2E8" BorderBrush="Transparent" FontSize="14" Cursor="Hand" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,16,0,16" Background="#FFFFFF33" />
                    <TextBlock x:Name="AdminNameTextBlock" TextWrapping="Wrap" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock x:Name="RoleNameTextBlock" Text="Role" Margin="0,3,0,14" Foreground="#B8D8BF" FontSize="12" />
                    <Button Content="Đăng xuất" Click="SignOutButton_Click" HorizontalContentAlignment="Left" Padding="0" Background="Transparent" Foreground="#E6F2E8" BorderBrush="Transparent" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="36,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Action Header -->
            <DockPanel LastChildFill="True">
                <!-- Action Panels docked to Right FIRST so they don't get pushed out -->
                
                <!-- Product Action Panel (Manager) -->
                <StackPanel x:Name="ProductActionPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Notification Bell Button -->
                    <Button x:Name="NotificationBellButton" Style="{StaticResource ModernIconButton}" Click="NotificationBellButton_Click" Margin="0,0,10,0" ToolTip="Xem thông báo cảnh báo kho">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="NotificationBadgeBorder" Background="#EF4444" CornerRadius="8" Margin="8,-10,-10,0" MinWidth="18" Height="18" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                <TextBlock x:Name="NotificationBadgeTextBlock" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>

                    <Border x:Name="BranchFilterContainer" Background="#FFFFFF" BorderBrush="#C2D6C6" BorderThickness="1.2" CornerRadius="8" Padding="12,0,8,0" Margin="0,0,10,0" Height="38" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏢 Kho:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#1F4D30" FontSize="13" />
                            <ComboBox x:Name="BranchFilterComboBox" Width="200" Height="30" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" DisplayMemberPath="BranchName" SelectedValuePath="Id" SelectionChanged="BranchFilterComboBox_SelectionChanged" FontSize="13" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource ModernPrimaryButton}" Content="+ Tạo sản phẩm" Click="AddProductButton_Click" Padding="14,0" Margin="0,0,10,0" />
                    <Button Style="{StaticResource ModernSecondaryButton}" Content="🔄 Tải lại" Click="RefreshButton_Click" Padding="14,0" />
                </StackPanel>

                <!-- User Action Panel (Admin) -->
                <StackPanel x:Name="UserActionPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button Style="{StaticResource ModernPrimaryButton}" Content="+ Tạo Tài Khoản" Click="AddUserButton_Click" Padding="16,0" Margin="0,0,10,0" />
                    <Button Style="{StaticResource ModernSecondaryButton}" Content="🔄 Tải lại" Click="RefreshUsersButton_Click" Padding="14,0" />
                </StackPanel>

                <!-- Order Action Panel (Staff) -->
                <StackPanel x:Name="OrderActionPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- Status Filter -->
                    <Border Background="#FFFFFF" BorderBrush="#C2D6C6" BorderThickness="1.2" CornerRadius="8" Padding="12,0,8,0" Margin="0,0,10,0" Height="38" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📌 Trạng thái:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#1F4D30" FontSize="13" />
                            <ComboBox x:Name="OrderStatusFilterComboBox" Width="160" Height="30" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" SelectionChanged="OrderStatusFilterComboBox_SelectionChanged" FontSize="13" Cursor="Hand">
                                <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True" Tag="ALL" />
                                <ComboBoxItem Content="Chờ duyệt (Pending)" Tag="Pending" />
                                <ComboBoxItem Content="Đã duyệt (Confirmed)" Tag="Confirmed" />
                                <ComboBoxItem Content="Đang giao (Shipping)" Tag="Shipping" />
                                <ComboBoxItem Content="Hoàn thành (Completed)" Tag="Completed" />
                                <ComboBoxItem Content="Đã hủy (Cancelled)" Tag="Cancelled" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ModernSecondaryButton}" Content="🔄 Tải lại" Click="RefreshOrdersButton_Click" Padding="14,0" />
                </StackPanel>

                <!-- Page Titles (Takes remaining space on the left) -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="PageTitleTextBlock" Text="Quản lý sản phẩm" FontSize="26" FontWeight="Bold" Foreground="#1D2A20" />
                    <TextBlock x:Name="PageSubtitleTextBlock" Text="Danh sách sản phẩm đang hoạt động từ FruitShop.Server" Margin="0,4,0,0" Foreground="#5A665E" FontSize="13" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Margin="0,18,0,14" Padding="14,10" Background="#E8F2EA" CornerRadius="8">
                <DockPanel>
                    <TextBlock x:Name="BranchBadgeTextBlock" Text="🏢 Chi nhánh: Toàn bộ hệ thống" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#1F4D30" />
                    <TextBlock x:Name="StatusTextBlock" Foreground="#275D38" FontWeight="Medium" />
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E0E6E1" BorderThickness="1" Padding="10">
                <Grid>
                    <!-- 1. Products DataGrid (Manager) -->
                    <DataGrid x:Name="ProductsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="44" AlternatingRowBackground="#F8FAF8" SelectionChanged="ProductsDataGrid_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="2*" MinWidth="180" />
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Tồn kho chi nhánh" Binding="{Binding StockQuantity}" Width="140" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="90" />
                            <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="2*" MinWidth="180" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 2. Users DataGrid (Admin) -->
                    <DataGrid x:Name="UsersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="44" AlternatingRowBackground="#F8FAF8" Background="Transparent" BorderThickness="0" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="130"/>
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="170"/>
                            <DataGridTextColumn Header="Vai trò (Role)" Binding="{Binding RoleName}" Width="110"/>
                            <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchName}" Width="180"/>
                            <DataGridTextColumn Header="Email / SĐT" Binding="{Binding Email}" Width="160"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding IsActive}" Width="90"/>
                            <DataGridTemplateColumn Header="Thao tác" Width="180" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="Khóa/Mở" Click="ToggleActive_Click" Margin="3,0" Padding="8,4" Background="#EDF2F7" Foreground="#2D3748" BorderBrush="#CBD5E0" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                                            <Button Content="Reset MK" Click="ResetPassword_Click" Margin="3,0" Padding="8,4" Background="#FEFCBF" Foreground="#744210" BorderBrush="#ECC94B" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 3. Orders DataGrid (Staff) -->
                    <DataGrid x:Name="OrdersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="46" AlternatingRowBackground="#F8FAF8" Background="Transparent" BorderThickness="0" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Mã đơn hàng" Binding="{Binding OrderCode}" Width="135" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchName}" Width="140" />
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="SĐT" Binding="{Binding CustomerPhone}" Width="105" />
                            <DataGridTextColumn Header="Tổng tiền (đ)" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="115" FontWeight="Bold" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding OrderStatus}" Width="100" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentMethod}" Width="95" />
                            <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentStatus}" Width="95" />
                            <DataGridTextColumn Header="Thời gian tạo" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135" />
                            
                            <!-- Thao tác nhân viên -->
                            <DataGridTemplateColumn Header="Thao tác nhân viên" Width="250" MinWidth="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Bước 1: Xác nhận đơn -->
                                            <Button Content="✓ Xác nhận đơn" Click="ConfirmOrder_Click" Margin="2,0" Padding="8,4" Background="#1F4D30" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Pending">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Bước 2: Bắt đầu giao hàng -->
                                            <Button Content="🚚 Giao hàng" Click="ShipOrder_Click" Margin="2,0" Padding="8,4" Background="#0284C7" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Confirmed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Confirm">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Bước 3: Đã giao hàng thành công -->
                                            <Button Content="✅ Đã giao hàng thành công" Click="CompleteOrder_Click" Margin="2,0" Padding="8,4" Background="#16A34A" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Shipping">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Nút Hủy đơn -->
                                            <Button Content="✖ Hủy" Click="CancelOrder_Click" Margin="3,0" Padding="6,4" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#F87171" BorderThickness="1" FontSize="11" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Completed">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Cancelled">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <TextBlock Text="Đã hoàn thành" Foreground="#16A34A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Completed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="Đã hủy" Foreground="#DC2626" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Cancelled">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>