<Window x:Class="FruitShop.Client.ExpiryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Hạn Sử Dụng Theo Chi Nhánh" Height="700" Width="1180" WindowStartupLocation="CenterOwner" Background="#F5F7F4">
    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel>
                <TextBlock Text="Quản Lý Hạn Sử Dụng Kho Hàng" FontSize="28" FontWeight="SemiBold" Foreground="#1D2A20" />
                <TextBlock Text="Sản phẩm từ hôm nay đến 2 ngày tới được xem là sắp hết hạn (giảm giá 50% tự động trên Web)." Margin="0,7,0,0" Foreground="#66706A" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" BorderBrush="#275D38" BorderThickness="1.5" CornerRadius="8" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏢 Kho:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#1F4D30" FontSize="13" />
                        <ComboBox x:Name="BranchFilterComboBox" Width="200" Height="32" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" DisplayMemberPath="BranchName" SelectedValuePath="Id" SelectionChanged="BranchFilterComboBox_SelectionChanged" FontSize="13" Cursor="Hand" />
                    </StackPanel>
                </Border>
                <Button Content="Ẩn sản phẩm đã chọn" Click="HideSelectedButton_Click" Height="38" Width="150" Margin="0,0,10,0" Background="#B42318" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="Tải lại" Click="RefreshButton_Click" Height="38" Width="90" Background="#FFFFFF" Foreground="#275D38" BorderBrush="#275D38" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,20,0,14" Padding="14,10" Background="#E8F2EA" CornerRadius="8">
            <DockPanel>
                <TextBlock x:Name="BranchBadgeTextBlock" Text="🏢 Kho Chi Nhánh: Toàn bộ hệ thống" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#1F4D30" />
                <TextBlock x:Name="StatusTextBlock" Foreground="#275D38" FontWeight="Medium" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" BorderBrush="#E0E6E1" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="⏳ Sắp hết hạn (0-2 ngày)" Foreground="#A15C00" FontSize="17" FontWeight="SemiBold" Margin="6,4,0,12" />
                    <DataGrid x:Name="ExpiringSoonDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40" SelectionChanged="ExpiringSoonDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchName}" Width="130" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Mã lô" Binding="{Binding BatchCode}" Width="100" />
                            <DataGridTextColumn Header="Hạn dùng" Binding="{Binding ExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" Width="95" />
                            <DataGridTextColumn Header="Còn (ngày)" Binding="{Binding DaysRemaining}" Width="80" />
                            <DataGridTextColumn Header="Tồn" Binding="{Binding StockQuantity}" Width="60" FontWeight="Bold" />
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E0E6E1" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="❌ Đã hết hạn" Foreground="#B42318" FontSize="17" FontWeight="SemiBold" Margin="6,4,0,12" />
                    <DataGrid x:Name="ExpiredDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40" SelectionChanged="ExpiredDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchName}" Width="130" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Mã lô" Binding="{Binding BatchCode}" Width="100" />
                            <DataGridTextColumn Header="Hạn dùng" Binding="{Binding ExpiryDate, StringFormat={}{0:dd/MM/yyyy}}" Width="95" />
                            <DataGridTextColumn Header="Quá hạn" Binding="{Binding DaysOverdue}" Width="80" />
                            <DataGridTextColumn Header="Tồn" Binding="{Binding StockQuantity}" Width="60" FontWeight="Bold" />
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
