<Window x:Class="FruitShop.Client.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm sản phẩm mới" Height="730" Width="680" WindowStartupLocation="CenterOwner"
        Background="#F5F7F4" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <StackPanel>
            <TextBlock Text="Thêm sản phẩm mới" FontSize="26" FontWeight="Bold" Foreground="#1D2A20" />
            <TextBlock Text="Tạo sản phẩm và thiết lập kho chi nhánh tương ứng." Margin="0,4,0,0" Foreground="#66706A" TextWrapping="Wrap" />
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>
                <!-- 1. Tên sản phẩm -->
                <TextBlock Text="Tên sản phẩm *" FontWeight="SemiBold" Foreground="#1D2A20" />
                <TextBox x:Name="NameTextBox" Margin="0,6,0,14" Height="38" Padding="10,7" FontSize="13" VerticalContentAlignment="Center" />

                <!-- 2. Chọn chi nhánh -->
                <TextBlock Text="Chi nhánh áp dụng *" FontWeight="SemiBold" Foreground="#1D2A20" />
                <ComboBox x:Name="BranchComboBox" DisplayMemberPath="BranchName" SelectedValuePath="Id" Margin="0,6,0,14" Height="38" Padding="8" FontSize="13" VerticalContentAlignment="Center" Cursor="Hand" />

                <!-- 3. Chọn danh mục -->
                <TextBlock Text="Danh mục sản phẩm *" FontWeight="SemiBold" Foreground="#1D2A20" />
                <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,6,0,14" Height="38" Padding="8" FontSize="13" VerticalContentAlignment="Center" Cursor="Hand" />

                <!-- 4. Giá bán & Tồn kho ban đầu -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Giá bán (đ) *" FontWeight="SemiBold" Foreground="#1D2A20" />
                        <TextBox x:Name="PriceTextBox" Margin="0,6,0,0" Height="38" Padding="10,7" FontSize="13" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Số lượng tồn kho ban đầu" FontWeight="SemiBold" Foreground="#1D2A20" />
                        <TextBox x:Name="InitialStockTextBox" Text="50" Margin="0,6,0,0" Height="38" Padding="10,7" FontSize="13" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 5. Đơn vị tính & Hạn sử dụng -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Đơn vị tính *" FontWeight="SemiBold" Foreground="#1D2A20" />
                        <TextBox x:Name="UnitTextBox" Margin="0,6,0,0" Height="38" Padding="10,7" Text="kg" FontSize="13" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Hạn sử dụng lô kho" FontWeight="SemiBold" Foreground="#1D2A20" />
                        <DatePicker x:Name="ExpiryDatePicker" Margin="0,6,0,0" Height="38" Padding="6,4" FontSize="13" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 6. Mô tả -->
                <TextBlock Text="Mô tả sản phẩm" FontWeight="SemiBold" Foreground="#1D2A20" />
                <TextBox x:Name="DescriptionTextBox" Margin="0,6,0,14" Height="70" Padding="10,7" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="13" />

                <!-- 7. Hình ảnh sản phẩm -->
                <TextBlock Text="Hình ảnh sản phẩm (Tùy chọn, JPG/JPEG/PNG/WEBP, tối đa 5 MB)" FontWeight="SemiBold" Foreground="#1D2A20" />
                <Grid Margin="0,6,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ImagePathTextBox" IsReadOnly="True" Height="38" Padding="10,7" VerticalContentAlignment="Center" FontSize="13" />
                    <Button Grid.Column="1" Content="Chọn ảnh..." Margin="10,0,0,0" Click="ChooseImageButton_Click" Background="#FFFFFF" Foreground="#1F4D30" BorderBrush="#1F4D30" FontWeight="SemiBold" Cursor="Hand" Height="38" />
                </Grid>

                <TextBlock x:Name="StatusTextBlock" MinHeight="24" TextWrapping="Wrap" Foreground="#B42318" FontWeight="Medium" />

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,10">
                    <Button Content="Hủy" Width="100" Height="40" Margin="0,0,12,0" Click="CancelButton_Click" Background="Transparent" Foreground="#1F4D30" BorderBrush="#C2D6C6" BorderThickness="1.2" FontWeight="SemiBold" Cursor="Hand" />
                    <Button x:Name="SaveButton" Content="Tạo sản phẩm" Width="140" Height="40" Click="SaveButton_Click" Background="#1F4D30" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
