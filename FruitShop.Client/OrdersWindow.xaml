<Window x:Class="FruitShop.Client.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Order management" Height="650" Width="1200" WindowStartupLocation="CenterOwner" Background="#F5F7F4">
    <Grid Margin="34,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel>
                <TextBlock Text="Qu&#x1EA3;n l&#x00FD; &#x0111;&#x01A1;n h&#x00E0;ng" FontSize="28" FontWeight="SemiBold" Foreground="#1D2A20" />
                <TextBlock Text="Danh s&#x00E1;ch &#x0111;&#x01A1;n h&#x00E0;ng kh&#x00E1;ch &#x0111;&#x00E3; &#x0111;&#x1EB7;t tr&#x00EA;n website." Margin="0,7,0,0" Foreground="#66706A" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="&#x0110;&#x00E1; &#x0111;&#x01B0;&#x1EE3;c thanh to&#x00E1;n" Click="MarkPaidButton_Click" Height="38" Width="150" Margin="0,0,10,0" Background="#275D38" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="Refresh" Click="RefreshButton_Click" Height="38" Width="100" Background="#FFFFFF" Foreground="#275D38" BorderBrush="#275D38" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,22,0,14" Padding="14,10" Background="#E8F2EA" CornerRadius="8"><TextBlock x:Name="StatusTextBlock" Foreground="#275D38" /></Border>
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E0E6E1" BorderThickness="1" Padding="10">
            <DataGrid x:Name="OrdersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="44" AlternatingRowBackground="#F8FAF8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                    <DataGridTextColumn Header="Order code" Binding="{Binding OrderCode}" Width="130" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding CustomerPhone}" Width="120" />
                    <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="65" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="110" />
                    <DataGridTextColumn Header="Order status" Binding="{Binding OrderStatus}" Width="110" />
                    <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="85" />
                    <DataGridTextColumn Header="Payment status" Binding="{Binding PaymentStatus}" Width="110" />
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
