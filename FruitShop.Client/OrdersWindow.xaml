<Window x:Class="FruitShop.Client.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Đơn Hàng Theo Chi Nhánh" Height="680" Width="1240" WindowStartupLocation="CenterOwner" Background="#F5F7F4">
    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel>
                <TextBlock Text="Quản Lý Đơn Hàng" FontSize="28" FontWeight="SemiBold" Foreground="#1D2A20" />
                <TextBlock Text="Danh sách đơn hàng khách đã đặt trên hệ thống và chi nhánh phụ trách." Margin="0,7,0,0" Foreground="#66706A" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" BorderBrush="#275D38" BorderThickness="1.5" CornerRadius="8" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏢 Chi nhánh:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#1F4D30" FontSize="13" />
                        <ComboBox x:Name="BranchFilterComboBox" Width="200" Height="32" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" DisplayMemberPath="BranchName" SelectedValuePath="Id" SelectionChanged="BranchFilterComboBox_SelectionChanged" FontSize="13" Cursor="Hand" />
                    </StackPanel>
                </Border>
                <Button Content="Xác nhận thanh toán" Click="MarkPaidButton_Click" Height="38" Width="155" Margin="0,0,10,0" Background="#275D38" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
                <Button Content="Tải lại" Click="RefreshButton_Click" Height="38" Width="90" Background="#FFFFFF" Foreground="#275D38" BorderBrush="#275D38" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,20,0,14" Padding="14,10" Background="#E8F2EA" CornerRadius="8">
            <DockPanel>
                <TextBlock x:Name="BranchBadgeTextBlock" Text="🏢 Chi nhánh: Toàn bộ hệ thống" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#1F4D30" />
                <TextBlock x:Name="StatusTextBlock" Foreground="#275D38" FontWeight="Medium" />
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E0E6E1" BorderThickness="1" Padding="10">
            <DataGrid x:Name="OrdersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="44" AlternatingRowBackground="#F8FAF8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                    <DataGridTextColumn Header="Mã đơn hàng" Binding="{Binding OrderCode}" Width="130" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchName}" Width="150" />
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="*" />
                    <DataGridTextColumn Header="SĐT" Binding="{Binding CustomerPhone}" Width="110" />
                    <DataGridTextColumn Header="Tổng tiền (đ)" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="115" FontWeight="Bold" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding OrderStatus}" Width="100" />
                    <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentMethod}" Width="95" />
                    <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentStatus}" Width="105" />
                    <DataGridTextColumn Header="Thời gian tạo" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
