<Window x:Class="FruitShop.Client.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Đơn Hàng Theo Chi Nhánh" Height="680" Width="1240" WindowStartupLocation="CenterOwner" Background="#F5F7F4">
    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action Header -->
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FFFFFF" BorderBrush="#C2D6C6" BorderThickness="1.2" CornerRadius="8" Padding="12,0,8,0" Margin="0,0,10,0" Height="38" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏢 Chi nhánh:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#1F4D30" FontSize="13" />
                        <ComboBox x:Name="BranchFilterComboBox" Width="200" Height="30" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" DisplayMemberPath="BranchName" SelectedValuePath="Id" SelectionChanged="BranchFilterComboBox_SelectionChanged" FontSize="13" Cursor="Hand" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource ModernPrimaryButton}" Content="✓ Xác nhận thanh toán" Click="MarkPaidButton_Click" Padding="16,0" Margin="0,0,10,0" />
                <Button Style="{StaticResource ModernSecondaryButton}" Content="🔄 Tải lại" Click="RefreshButton_Click" Padding="14,0" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Quản Lý Đơn Hàng" FontSize="26" FontWeight="Bold" Foreground="#1D2A20" />
                <TextBlock Text="Danh sách đơn hàng khách đã đặt trên hệ thống và chi nhánh phụ trách." Margin="0,4,0,0" Foreground="#5A665E" FontSize="13" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,18,0,14" Padding="14,10" Background="#E8F2EA" CornerRadius="8">
            <DockPanel>
                <TextBlock x:Name="BranchBadgeTextBlock" Text="🏢 Chi nhánh: Toàn bộ hệ thống" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#1F4D30" />
                <TextBlock x:Name="StatusTextBlock" Foreground="#275D38" FontWeight="Medium" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E0E6E1" BorderThickness="1" Padding="10">
            <DataGrid x:Name="OrdersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="44" AlternatingRowBackground="#F8FAF8" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                    <DataGridTextColumn Header="Mã đơn hàng" Binding="{Binding OrderCode}" Width="130" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchName}" Width="150" />
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="*" MinWidth="130" />
                    <DataGridTextColumn Header="SĐT" Binding="{Binding CustomerPhone}" Width="110" />
                    <DataGridTextColumn Header="Tổng tiền (đ)" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="120" FontWeight="Bold" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding OrderStatus}" Width="100" />
                    <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentMethod}" Width="105" />
                    <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentStatus}" Width="110" />
                    <DataGridTextColumn Header="Thời gian tạo" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
