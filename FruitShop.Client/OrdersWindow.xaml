<Window x:Class="FruitShop.Client.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Đơn Hàng Theo Chi Nhánh" Height="700" Width="1320" WindowStartupLocation="CenterOwner" Background="#F5F7F4">
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action Header -->
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Branch Filter -->
                <Border Background="#FFFFFF" BorderBrush="#C2D6C6" BorderThickness="1.2" CornerRadius="8" Padding="12,0,8,0" Margin="0,0,10,0" Height="38" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏢 Chi nhánh:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#1F4D30" FontSize="13" />
                        <ComboBox x:Name="BranchFilterComboBox" Width="180" Height="30" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" DisplayMemberPath="BranchName" SelectedValuePath="Id" SelectionChanged="BranchFilterComboBox_SelectionChanged" FontSize="13" Cursor="Hand" />
                    </StackPanel>
                </Border>

                <!-- Status Filter -->
                <Border Background="#FFFFFF" BorderBrush="#C2D6C6" BorderThickness="1.2" CornerRadius="8" Padding="12,0,8,0" Margin="0,0,10,0" Height="38" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📌 Trạng thái:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#1F4D30" FontSize="13" />
                        <ComboBox x:Name="StatusFilterComboBox" Width="160" Height="30" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" SelectionChanged="StatusFilterComboBox_SelectionChanged" FontSize="13" Cursor="Hand">
                            <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True" Tag="ALL" />
                            <ComboBoxItem Content="Chờ duyệt (Pending)" Tag="Pending" />
                            <ComboBoxItem Content="Đã duyệt (Confirmed)" Tag="Confirmed" />
                            <ComboBoxItem Content="Đang giao (Shipping)" Tag="Shipping" />
                            <ComboBoxItem Content="Hoàn thành (Completed)" Tag="Completed" />
                            <ComboBoxItem Content="Đã hủy (Cancelled)" Tag="Cancelled" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource ModernSecondaryButton}" Content="🔄 Tải lại" Click="RefreshButton_Click" Padding="14,0" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Quản Lý Đơn Hàng" FontSize="26" FontWeight="Bold" Foreground="#1D2A20" />
                <TextBlock Text="Duyệt đơn, điều phối giao hàng và theo dõi thanh toán đơn hàng thời gian thực." Margin="0,4,0,0" Foreground="#5A665E" FontSize="13" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,16,0,14" Padding="14,10" Background="#E8F2EA" CornerRadius="8">
            <DockPanel>
                <TextBlock x:Name="BranchBadgeTextBlock" Text="🏢 Chi nhánh: Toàn bộ hệ thống" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#1F4D30" />
                <TextBlock x:Name="StatusTextBlock" Foreground="#275D38" FontWeight="Medium" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E0E6E1" BorderThickness="1" Padding="10">
            <DataGrid x:Name="OrdersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="46" AlternatingRowBackground="#F8FAF8" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Mã đơn hàng" Binding="{Binding OrderCode}" Width="135" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchName}" Width="140" />
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="SĐT" Binding="{Binding CustomerPhone}" Width="105" />
                    <DataGridTextColumn Header="Tổng tiền (đ)" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="115" FontWeight="Bold" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding OrderStatus}" Width="100" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentMethod}" Width="95" />
                    <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentStatus}" Width="95" />
                    <DataGridTextColumn Header="Thời gian tạo" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135" />
                    
                    <!-- Cột Thao tác chuyển trạng thái cho nhân viên -->
                    <DataGridTemplateColumn Header="Thao tác nhân viên" Width="250" MinWidth="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Bước 1: Xác nhận đơn (Pending -> Confirmed) -->
                                    <Button Content="✓ Xác nhận đơn" Click="ConfirmOrder_Click" Margin="2,0" Padding="8,4" Background="#1F4D30" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Pending">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Bước 2: Bắt đầu giao hàng (Confirmed -> Shipping) -->
                                    <Button Content="🚚 Giao hàng" Click="ShipOrder_Click" Margin="2,0" Padding="8,4" Background="#0284C7" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Confirmed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Confirm">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Bước 3: Đã giao hàng thành công (Shipping -> Completed) -->
                                    <Button Content="✅ Đã giao hàng thành công" Click="CompleteOrder_Click" Margin="2,0" Padding="8,4" Background="#16A34A" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Shipping">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Nút Hủy đơn (khi đơn chưa hoàn tất và chưa hủy) -->
                                    <Button Content="✖ Hủy" Click="CancelOrder_Click" Margin="3,0" Padding="6,4" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#F87171" BorderThickness="1" FontSize="11" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Completed">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Cancelled">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Nhãn khi hoàn tất -->
                                    <TextBlock Text="Đã hoàn thành" Foreground="#16A34A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Completed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Nhãn khi đã hủy -->
                                    <TextBlock Text="Đã hủy" Foreground="#DC2626" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Cancelled">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
